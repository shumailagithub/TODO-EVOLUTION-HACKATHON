"""
Password hashing and verification utilities.
Uses bcrypt for secure password storage.
"""
from typing import NewType
from passlib.context import CryptContext

# bcrypt context
pwd_context = CryptContext(
    schemes=["bcrypt"],
    deprecated="auto"
)


def hash_password(password: str) -> str:
    """
    Hash a password using bcrypt.

    Args:
        password: Plain text password

    Returns:
        Hashed password string (different each call due to salt)
    """
    # Truncate password to 72 bytes to comply with bcrypt limitations
    truncated_password = password[:72] if len(password.encode('utf-8')) > 72 else password
    return pwd_context.hash(truncated_password)


def verify_password(plain: str, hashed: str) -> bool:
    """
    Verify a password against a hash.

    Args:
        plain: Plain text password
        hashed: Hashed password to verify against

    Returns:
        True if password matches hash, False otherwise
    """
    # Truncate password to 72 bytes to comply with bcrypt limitations
    truncated_plain = plain[:72] if len(plain.encode('utf-8')) > 72 else plain
    return pwd_context.verify(truncated_plain, hashed)
